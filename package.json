{
  "name": "askwise",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch:model-libs": "node scripts/fetch-model-libs.mjs",
    "build": "npm run fetch:model-libs && rm -rf dist && tsc && vite build --mode production && node scripts/sanitize-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "train:export-seed": "tsx scripts/export-sft-seed.ts",
    "train:check-env": "python training/00_check_env.py",
    "capture:assets": "CAPTURE=1 playwright test tests/e2e/capture-assets.spec.ts && node scripts/make-demo-gif.mjs",
    "zip": "npm run build && node scripts/zip.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "nanoid": "^5.1.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
