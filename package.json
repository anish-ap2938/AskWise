{
  "name": "askwise",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "fetch:model-libs": "node scripts/fetch-model-libs.mjs",
    "build": "npm run fetch:model-libs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && vite build --mode production && node scripts/sanitize-manifest.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval": "tsx scripts/eval.ts",
    "train:export-seed": "tsx scripts/export-sft-seed.ts",
    "train:check-env": "training\\.venv\\Scripts\\python.exe training\\00_check_env.py",
    "train:dataset": "training\\.venv\\Scripts\\python.exe training\\01_build_prompt_dataset.py && training\\.venv\\Scripts\\python.exe training\\02_augment_dataset.py",
    "train:lora": "training\\.venv\\Scripts\\python.exe training\\03_train_lora.py",
    "train:merge": "training\\.venv\\Scripts\\python.exe training\\04_merge_lora.py",
    "train:corpora": "training\\.venv\\Scripts\\python.exe training\\10_download_corpora.py",
    "train:label": "training\\.venv\\Scripts\\python.exe training\\11_autolabel_modes.py",
    "train:intent": "training\\.venv\\Scripts\\python.exe training\\12_train_intent_clf.py",
    "train:tune-hybrid": "tsx scripts/tune-hybrid.ts",
    "train:synth": "training\\.venv\\Scripts\\python.exe training\\13_synth_mode_prompts.py --verify",
    "train:sft-pool": "training\\.venv\\Scripts\\python.exe training\\14_build_sft_pool.py",
    "train:sft-drafts": "tsx scripts/export-drafts.ts training/data/raw/sft_pool.jsonl training/data/raw/sft_drafts.jsonl",
    "train:sft-teacher": "training\\.venv\\Scripts\\python.exe training\\15_build_sft_teacher.py",
    "capture:assets": "CAPTURE=1 playwright test tests/e2e/capture-assets.spec.ts && node scripts/make-demo-gif.mjs",
    "zip": "npm run build && node scripts/zip.mjs"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.84",
    "nanoid": "^5.1.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@playwright/test": "^1.51.1",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
